{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MUSHCode",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#commands"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#patterns"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "//",
          "end": "$",
          "name": "comment.line.mush"
        },
        {
          "match": "@@.*$",
          "name": "comment.line.mush"
        }
      ]
    },
    "commands": {
      "patterns": [
        {
          "match": "(?i)(?<![\\w@])(page|pose|reply|say|think|whisper)(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.messaging.mush"
        },
        {
          "match": "(?i)@(emit|eval|femit|fpose|fsay|npemit|oemit|pemit)(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.messaging.mush"
        },
        {
          "match": "(?i)(?<![\\w@])(drop|enter|get|give|goto|home|leave)(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.movement.mush"
        },
        {
          "match": "(?i)@(teleport|tel)(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.movement.mush"
        },
        {
          "match": "(?i)(?<![\\w@])(use)(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.database.mush"
        },
        {
          "match": "(?i)@(alias|chown|chzone|clone|cpattr|create|destroy|dest|dig|edit|forwardlist|link|lock|mvattr|name|open|parent|power|propdir|quota|robot|set|unlink|unlock|wipe)(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.database.mush"
        },
        {
          "match": "(?i)@(dolist|dol|drain|end|force|fo|halt|include|notify|program|ps|quitprogram|redirect|sql|switch|swi|trigger|tr|verb|wait)(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.program.mush"
        },
        {
          "match": "(?i)@(colormap|cron|crondel|crontab|decompile|deco|doing|entrances|find|floaters|list|listcommands|listmotd|password|reference|search|stats|sweep)(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.other.mush"
        },
        {
          "match": "(?i)(?<![\\w@])(examine|ex|inventory|kill|look|score|version)(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.other.mush"
        },
        {
          "match": "(?<![\\w@])(DOING|IDLE|INFO|LOGOUT|OUTPUTPREFIX|OUTPUTSUFFIX|PUEBLOCLIENT|QUIT|SESSION|WHO)(?=[/\\s]|$)",
          "name": "keyword.control.command.other.mush"
        }
      ]
    },
    "attributes": {
      "patterns":[
        {
          "match": "(?i)@[aio]?(?:desc|descr|descri|describ|describe)(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.attribute.describe.mush"
        },{
          "match": "(?i)@[ao]?(?:succ|succe|succes|success)(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.attribute.success.mush"
        },{
          "match": "(?i)@[ao]?[delrg]?fail(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.attribute.fail.mush"
        },{
          "match": "(?i)@[ao]?(?:dro|drop)(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.attribute.drop.mush"
        },{
          "match": "(?i)@(?:[ao]?enter|oxenter)(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.attribute.enter.mush"
        },{
          "match": "(?i)@[ao]?kill(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.attribute.kill.mush"
        },{
          "match": "(?i)@(?:[ao]?leave|oxleave)(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.attribute.leave.mush"
        },{
          "match": "(?i)@(?:away|idle|reject)(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.attribute.away.mush"
        },{
          "match": "(?i)@[ao]?(?:use|ufail)(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.attribute.use.mush"
        },{
          "match": "(?i)@aclone(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.attribute.aclone.mush"
        },
        {
          "match": "(?i)@last(?:site)?(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.attribute.last.mush"
        },
        {
          "match": "(?i)@logindata(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.attribute.logindata.mush"
        },{
          "match": "(?i)@a?mail(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.attribute.mail.mush"
        },{
          "match": "(?i)@malias(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.attribute.malias.mush"
        },{
          "match": "(?i)@mailsucc(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.attribute.mailsucc.mush"
        },{
          "match": "(?i)@signature(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.attribute.signature.mush"
        },{
          "match": "(?i)@[ao]?(?:tport|to?fail)(?-i)(?=[/\\s]|$)",
          "name": "keyword.control.command.attribute.tport.mush"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "support.function.mush",
          "match": "\\b(?i)(ABS|ACCENT|ACCNAME|ACOS|ADD|AFTER|ALIAS|ALIGN|ALLOF|ALPHAMAX|ALPHAMIN|AND|ANDFLAGS|ANDLFLAGS|ANDLPOWERS|ANSI|APOSS|ART|ASIN|ATAN|ATAN2|ATRLOCK|ATTRIB_SET|BAND|BASECONV|BEEP|BEFORE|BENCHMARK|BNAND|BNOT|BOR|BOUND|BRACKETS|BXOR|CAND|CAPSTR|CASE|CASEALL|CAT|CBUFFER|CBUFFERADD|CDESC|CEIL|CEMIT|CENTER|CFLAGS|CHANNELS|CHECKPASS|CHILDREN|CHR|CLFLAGS|CLOCK|CLONE|CMDS|CMOGRIFIER|CMSGS|COLORS|COMP|CON|COND|CONDALL|CONFIG|CONN|CONTROLS|CONVSECS|CONVTIME|CONVUTCSECS|CONVUTCTIME|COR|COS|COWNER|CREATE|CRECALL|CSECS|CSTATUS|CTIME|CTITLE|CTU|CUSERS|CWHO|DEC|DECODE64|DECOMPOSE|DECRYPT|DEFAULT|DIE|DIG|DIGEST|DIST2D|DIST3D|DIV|DOING|E|EDEFAULT|EDIT|ELEMENTS|ELIST|ELOCK|EMIT|ENCODE64|ENCRYPT|ENDTAG|ENTRANCES|EQ|ESCAPE|ETIME|ETIMEFMT|EVAL|EXIT|EXTRACT|FDIV|FILTER|FILTERBOOL|FINDABLE|FIRST|FIRSTOF|FLAGS|FLIP|FLOOR|FLOORDIV|FMOD|FN|FOLD|FOLDERSTATS|FOLLOWERS|FOLLOWING|FOREACH|FRACTION|FULLALIAS|FULLNAME|FUNCTIONS|GET|GET_EVAL|GETPIDS|GRAB|GRABALL|GREP|GREPI|GT|GTE|HASATTR|HASATTRP|HASATTRPVAL|HASATTRVAL|HASFLAG|HASPOWER|HASTYPE|HEIGHT|HIDDEN|HOME|HOST|HTML|IBREAK|IDLE|IF|IFELSE|ILEV|INAME|INC|INDEX|INUM|IPADDR|ISDAYLIGHT|ISDBREF|ISINT|ISNUM|ISOBJID|ISREGEXP|ISWORD|ITEMIZE|ITEMS|ITER|ITEXT|LALIGN|LAST|LATTR|LATTRP|LCON|LCSTR|LDELETE|LEFT|LEMIT|LETQ|LEXITS|LFLAGS|LINK|LINSERT|LIST|LISTQ|LIT|LJUST|LLOCKFLAGS|LLOCKS|LMATH|LN|LNUM|LOC|LOCALIZE|LOCATE|LOCK|LOCKFILTER|LOCKFLAGS|LOCKOWNER|LOCKS|LOG|LPARENT|LPIDS|LPLAYERS|LPORTS|LPOS|LREPLACE|LSEARCH|LSEARCHR|LSET|LSTATS|LT|LTE|LTHINGS|LVCON|LVEXITS|LVPLAYERS|LVTHINGS|LWHO|LWHOID|MAIL|MAILDSTATS|MAILFROM|MAILFSTATS|MAILLIST|MAILSEND|MAILSTATS|MAILSTATUS|MAILSUBJECT|MAILTIME|MALIAS|MAP|MAPSQL|MATCH|MATCHALL|MAX|MEAN|MEDIAN|MEMBER|MERGE|MESSAGE|MID|MIN|MIX|MODULO|MONEY|MONIKER|MSECS|MTIME|MUDNAME|MUDURL|MUL|MUNGE|MWHO|MWHOID|NAME|NAMEGRAB|NAMEGRABALL|NAMELIST|NAND|NATTR|NATTRP|NCAND|NCHILDREN|NCON|NCOND|NCONDALL|NCOR|NEARBY|NEQ|NEXITS|NEXT|NEXTDBREF|NLSEARCH|NMWHO|NOR|NOT|NPLAYERS|NSCEMIT|NSEARCH|NSEMIT|NSLEMIT|NSOEMIT|NSPEMIT|NSPROMPT|NSREMIT|NSZEMIT|NTHINGS|NULL|NUM|NUMVERSION|NVCON|NVEXITS|NVPLAYERS|NVTHINGS|NWHO|OBJ|OBJEVAL|OBJID|OBJMEM|OEMIT|OPEN|OR|ORD|ORDINAL|ORFLAGS|ORLFLAGS|ORLPOWERS|OWNER|PARENT|PCREATE|PEMIT|PFUN|PI|PIDINFO|PLAYER|PLAYERMEM|PMATCH|POLL|PORTS|POS|POSS|POWER|POWERS|PROMPT|PUEBLO|QUOTA|R|RAND|RANDWORD|RECV|REGEDIT|REGEDITALL|REGEDITALLI|REGEDITI|REGISTERS|REGLATTR|REGLATTRP|REGLMATCH|REGLMATCHALL|REGLMATCHALLI|REGLMATCHI|REGMATCH|REGMATCHI|REGNATTR|REGNATTRP|REGRAB|REGRABALL|REGRABALLI|REGRABI|REGREP|REGREPI|REGXATTR|REGXATTRP|REMAINDER|REMIT|REMOVE|RENDER|REPEAT|REST|RESTARTS|RESTARTTIME|RESWITCH|RESWITCHALL|RESWITCHALLI|RESWITCHI|REVWORDS|RIGHT|RJUST|RLOC|RNUM|ROOM|ROOT|ROUND|S|SCAN|SCRAMBLE|SECS|SECURE|SENT|SET|SETDIFF|SETINTER|SETQ|SETR|SETUNION|SHA0|SHL|SHR|SHUFFLE|SIGN|SIN|SLEV|SORT|SORTBY|SORTKEY|SOUNDEX|SOUNDSLIKE|SPACE|SPEAK|SPEAKPENN|SPELLNUM|SPLICE|SQL|SQLESCAPE|SQRT|SQUISH|SSL|STARTTIME|STDDEV|STEP|STEXT|STRALLOF|STRCAT|STRDELETE|STRFIRSTOF|STRINGSECS|STRINSERT|STRIPACCENTS|STRIPANSI|STRLEN|STRMATCH|STRREPLACE|SUB|SUBJ|SWITCH|SWITCHALL|T|TABLE|TAG|TAGWRAP|TAN|TEL|TERMINFO|TESTLOCK|TEXTENTRIES|TEXTFILE|TIME|TIMEFMT|TIMESTRING|TR|TRIM|TRIMPENN|TRIMTINY|TRUNC|TYPE|UCSTR|UDEFAULT|U|UFUN|ULAMBDA|ULDEFAULT|ULOCAL|UNIQUE|UNSETQ|UPTIME|UTCTIME|V|VADD|VALID|VCROSS|VDIM|VDOT|VERSION|VISIBLE|VMAG|VMAX|VMIN|VMUL|VSUB|VUNIT|WHERE|WIDTH|WILDGREP|WILDGREPI|WIPE|WORDPOS|WORDS|WRAP|XATTR|XATTRP|XCON|XEXITS|XGET|XMWHO|XMWHOID|XOR|XPLAYERS|XTHINGS|XVCON|XVEXITS|XVPLAYERS|XVTHINGS|XWHO|XWHOID|ZEMIT|ZFUN|ZMWHO|ZONE|ZWHO)(?-i)(?=\\()"
        }
      ]
    },
    "patterns": {
      "patterns": [
        {
          "match": "&\\S*",
          "name": "entity.other.attribute-name.mush"
        },
        {
          "match": "%c.|%(?!(q|i|v)).",
          "name": "constant.character.escape.mush"
        },
        {
          "match": "%(q|v|i)(?!<).",
          "name": "variable.other.register.mush"
        },
        {
          "match": "%q<[^>]*>",
          "name": "variable.other.register.mush"
        },
        {
          "match": "#-?\\d+",
          "name": "constant.numeric.dbref.mush"
        },
        {
          "match": "\\b[\\w]+(?=\\()",
          "name": "entity.name.function.mush"
        }
      ]
    }
  },
  "scopeName": "text.mush"
}

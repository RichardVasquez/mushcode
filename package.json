{
  "name": "mushcode",
  "displayName": "MUSHCode",
  "description": "A softcode unformatter+",
  "repository": "https://github.com/RichardVasquez/mushcode",
  "author": "Richard Vasquez",
  "contributors": [
    "Lemuel L. Canady, Jr"
  ],
  "license": "Apache-2.0",
  "icon": "mushcode.png",
  "version": "0.4.2",
  "engines": {
    "vscode": "^1.71.0"
  },
  "publisher": "penguinpark",
  "scripts": {
    "vscode:prepublish": "npm run build",
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "esbuild-base": "esbuild extension.js --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run clean && npm run esbuild-base -- --sourcemap",
    "test": "node --test format-output.test.js",
    "build": "npm run clean && npm run esbuild-base -- --minify",
    "package": "node scripts/package-vsix.js",
    "install:local": "node scripts/install-vsix.js",
    "release:local": "npm test && npm run build && npm run package && npm run install:local"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:mush",
    "onCommand:extension.format",
    "onCommand:extension.postSelection"
  ],
  "main": "out/main.js",
  "contributes": {
    "configuration": {
      "title": "MUSHCode",
      "properties": {
        "game.dbref": {
          "type": "string",
          "default": "",
          "description": "The dbref of your API object."
        },
        "game.password": {
          "type": "string",
          "default": "",
          "description": "The Password for your RhostMUSH game."
        },
        "game.host": {
          "type": "string",
          "default": "",
          "description": "The Hostname for your RhostMUSH game."
        },
        "game.port": {
          "type": "number",
          "default": 4203,
          "description": "The Port for your RhostMUSH game."
        },
        "mushcode.blockComments.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Highlight /* ... */ as block comments and enable block comment editing commands."
        }
      }
    },
    "keybindings": [
      {
        "command": "extension.postSelection",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "editorTextFocus"
      }
    ],
    "commands": [
      {
        "command": "extension.format",
        "title": "Format MUSHCode"
      },
      {
        "command": "extension.postSelection",
        "title": "Post Formatted Code to Game"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "extension.format",
          "group": "navigation"
        },
        {
          "command": "extension.postSelection",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "mush",
        "aliases": [
          "MUSHCode",
          "mush"
        ],
        "extensions": [
          ".mu",
          ".mush",
          ".mux"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mush",
        "scopeName": "text.mush",
        "path": "./syntaxes/mush.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "mush",
        "scopes": {
          "comment": [
            "comment.block.mush"
          ]
        }
      }
    ]
  },
  "dependencies": {
    "@penguinpark/mush-format": "1.0.0",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.15.7"
  }
}
